{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "fs:default",
    "fs:scope-appdata-recursive",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-exists",
    "fs:allow-write",
    "fs:allow-create",
    "fs:allow-mkdir"
  ]
}